---
import { HREF_APP } from "astro:env/client";
import { Icon } from "astro-icon/components";
import { PLATFORM_DESCRIPTION } from "astro:env/client";
import HomeFeature from "#src/components/HomeFeature.astro";
import Link from "#src/components/Link.astro";
import LinkNext from "#src/components/LinkNext.astro";
import Strong from "#src/components/Strong.astro";
import DefaultLayout from "#src/layouts/DefaultLayout.astro";
---

<DefaultLayout description={PLATFORM_DESCRIPTION}>
  <main class="flex-1 px-6 mbs-4">
    <div class="flex flex-col gap-10">
      <div class="">
        <h1 class="bg-linear-45 from-emerald-400 to-yellow-300 bg-clip-text text-transparent text-3xl font-extrabold sm:text-4xl">
          Make the Map of Your Online Presence
        </h1>
        <h2 class="text-xl mbs-4 sm:text-2xl">Create micro-pages and profiles easily and instantly</h2>
        <LinkNext class="mbs-6 text-lg" href={HREF_APP}>
          <Icon name="rocket" size="1.25em" />
          Get started now
        </LinkNext>
      </div>
      <img
        alt="Micropage example"
        class="border-2 border-zinc-700 rounded-2xl aspect-3/4 object-cover object-top select-none hover:border-emerald-400 transition-colors max-w-md w-full mx-auto"
        draggable="false"
        src="/profile.webp"
        title="Micropage example"
      />
    </div>
    <div class="flex flex-col gap-7 relative max-w-max mx-auto mbs-12 *:relative *:flex *:items-start *:gap-4 before:bg-zinc-700 before:absolute before:inset-s-5.75 before:inset-bs-11.75 lg:before:w-0.5 lg:before:h-32.5">
      <HomeFeature icon="external">
        <Fragment slot="title">Embed Content</Fragment>
        Seamlessly integrate content from <Strong>YouTube</Strong>, <Strong>Dailymotion</Strong>, and more.{" "}
        <Link href="/i/faq#details-external-content">Supported external websites</Link>
      </HomeFeature>

      <HomeFeature icon="markdown">
        <Fragment slot="title">Write Markdown</Fragment>
        Format your content effortlessly using the familiar syntax you already know
      </HomeFeature>

      <HomeFeature icon="security">
        <Fragment slot="title">Privacy First</Fragment>
        <Strong>profile.rocks</Strong> never tracks visitors, uses advertising cookies, or sells your data. Your privacy is guaranteed
      </HomeFeature>
    </div>
  </main>
</DefaultLayout>
