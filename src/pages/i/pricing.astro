---
import MainLayout from "#src/layouts/MainLayout.astro";
import PricingProfile from "#src/components/PricingProfile.astro";
---

<MainLayout title="Pricing">
  <h1 class="text-center text-4xl sm:text-5xl">Pricing</h1>

  <section class="mbs-6">
    <hgroup class="mbe-5 text-center">
      <h2 class="text-2xl sm:text-3xl">Profile plans</h2>
      <p class="mbs-1.5 text-lg text-zinc-300 sm:text-xl">per profile</p>
    </hgroup>
    <PricingProfile />
  </section>
</MainLayout>
