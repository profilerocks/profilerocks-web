---
import { LEGAL_DATA, PLATFORM_NAME } from "astro:env/client";
import Link from "#src/components/Link.astro";
import ArticleLayout from "#src/layouts/ArticleLayout.astro";

const TITLE = "Legal Notice";
---

<ArticleLayout title={TITLE}>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <h1 class="text-center text-3xl">{TITLE}</h1>

  <p class="my-6 text-zinc-300 select-none">{LEGAL_DATA}</p>

  <h2 class="text-2xl">General conditions of use</h2>
  <p class="mbs-3 text-zinc-300">
    This Legal Notice governs the access and use of <strong class="font-medium text-zinc-200">{PLATFORM_NAME}</strong>. By using the
    platform, you acquire the status of "User" and accept the{" "}
    <Link href="/i/terms" rel="terms-of-service">
      terms of service
    </Link>{" "}
    and the{" "}
    <Link href="/i/privacy" rel="privacy-policy">
      privacy policy
    </Link>
    .
  </p>

  <h2 class="mbs-6 text-2xl">Intellectual property</h2>
  <p class="mbs-3 text-zinc-300">
    All content and design are protected by intellectual property rights. Unauthorised reproduction is prohibited.
  </p>

  <h2 class="mbs-6 text-2xl">Limitation of liability</h2>
  <p class="my-3 text-zinc-300">
    <strong class="font-medium text-zinc-200">{PLATFORM_NAME}</strong> acts only as a hosting and linking service. The user agrees to use
    the platform in accordance with the Law and these terms. Users are solely responsible for the content they publish on their profiles.
  </p>

  <div class="rounded-xl border-rose-500 bg-rose-950 p-3 sm:rounded-s-xs sm:border-s-4 sm:px-4">
    <h3 class="text-xl font-medium text-rose-400">Important</h3>
    <p class="mbs-1.5 text-pretty text-rose-300">
      Users who use the platform to promote professional or commercial activities are independently responsible for complying with their own
      legal obligations, including the inclusion of their own Legal Notice and any other local regulatory requirements applicable to their
      specific activity.
    </p>
  </div>

  <h2 class="mbs-6 text-2xl">Changes to this Legal Notice</h2>
  <p class="mbs-3 text-zinc-300">This Legal Notice may be updated from time to time.</p>
</ArticleLayout>
