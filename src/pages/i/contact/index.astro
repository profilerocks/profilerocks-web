---
import { Icon } from "astro-icon/components";
import emails from "#shared/email.json";
import MainLayout from "#src/layouts/MainLayout.astro";
import LinkNext from "#src/components/LinkNext.astro";

const iconSendDimension = "1.25em";
---

<MainLayout>
  <h1 class="text-3xl sm:text-4xl text-center text-zinc-200">Contact</h1>

  <div class="flex gap-8 flex-col mx-auto mbs-6 max-w-2xl *:flex *:flex-col *:gap-4.5 *:border-bs *:border-emerald-400 *:pbs-4 sm:mbs-8">
    <article>
      <h2 class="flex items-center gap-2.5 px-1.5 min-w-max text-emerald-400 text-xl">
        <Icon name="pencil" class="min-w-6.5 h-6.5" />
        General
      </h2>
      <p class="flex flex-start gap-3 text-zinc-300 px-2">
        <Icon name="info" class="min-w-5.5 h-5.5" />
        For support, reports, bugs, or feedback, please use this address.
      </p>
      <p class="flex flex-start gap-3 text-zinc-300 px-2">
        <Icon name="email" class="min-w-5.5 h-5.5" />
        {emails.contact}
      </p>
      <LinkNext href={`mailto:${emails.contact}`}>
        <Icon name="send" size={iconSendDimension} />
        Send an email
      </LinkNext>
    </article>
    <article>
      <h2 class="flex items-center gap-2.5 px-1.5 min-w-max text-emerald-400 text-xl">
        <Icon name="report" class="min-w-6.5 h-6.5" />
        Report a violation
      </h2>
      <p class="flex flex-start gap-3 text-zinc-300 px-2">
        <Icon name="info" class="min-w-5.5 h-5.5" />
        If you encounter profiles that seem inappropriate or problematic, you can report them. For more details, please visit the report
        information page.
      </p>
      <LinkNext href="/i/contact/report">
        <Icon name="page" size={iconSendDimension} />
        Go to report page
      </LinkNext>
    </article>
  </div>
</MainLayout>
