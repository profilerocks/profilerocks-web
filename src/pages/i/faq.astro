---
import { PLATFORM_NAME } from "astro:env/client";
import Link from "#src/components/Link.astro";
import Summary from "#src/components/Summary.astro";
import MainLayout from "#src/layouts/MainLayout.astro";
---

<script>
  function openActiveDetails() {
    const id = window.location.hash.replace("#", "");

    if (id) {
      const target = document.getElementById(id);

      if (target && target instanceof HTMLDetailsElement) {
        target.open = true;
      }
    }
  }

  // Run on page load
  window.addEventListener("DOMContentLoaded", openActiveDetails);
  // Run if the hash changes without reloading
  window.addEventListener("hashchange", openActiveDetails);
</script>

<MainLayout title="FAQs">
  <h1 class="text-center text-3xl">Frequently Asked Questions</h1>
  <section
    class="mx-auto mbs-4 max-w-3xl *:scroll-mbs-12.5 *:border-be *:border-zinc-700 *:details-content:h-0 *:details-content:overflow-clip *:details-content:opacity-0 *:details-content:transition-all *:details-content:transition-discrete *:open:details-content:h-auto *:open:details-content:opacity-100"
    style={{ "interpolate-size": "allow-keywords" }}
  >
    <details class="group" id="details-external-content">
      <Summary>Which websites are supported for external content?</Summary>
      <p class="text-zinc-300">
        <strong class="font-medium text-zinc-200">{PLATFORM_NAME}</strong> utilizes the{" "}
        <Link href="https://www.npmjs.com/package/link-to-iframe" target="_blank" rel="noopener noreferrer">
          link-to-iframe
        </Link>{" "}
        library to power profile link previews.
      </p>
      <p class="pbs-2 pbe-5 text-zinc-300">
        A comprehensive list of supported platforms is available in its{" "}
        <Link
          href="https://github.com/crisp-oss/link-to-iframe?tab=readme-ov-file#supported-services"
          target="_blank"
          rel="noopener noreferrer"
        >
          official documentation
        </Link>
        .
      </p>
    </details>
    <details class="group" id="details-subscription-all-profiles">
      <Summary>Does a premium subscription apply to all profiles in my account?</Summary>
      <p class="text-zinc-300">No, premium subscriptions are tied to a single profile.</p>
      <p class="pbs-2 pbe-5 text-zinc-300">To access premium features on multiple profiles, each one must be upgraded individually.</p>
    </details>
  </section>
</MainLayout>
