---
import { PLATFORM_NAME } from "astro:env/client";
import emails from "#shared/email.json";
import Link from "#src/components/Link.astro";
import ArticleLayout from "#src/layouts/ArticleLayout.astro";

const CLOUDFLARE_COOKIE_POLICY = "https://www.cloudflare.com/cookie-policy/";
---

<ArticleLayout title="Cookie Policy">
  <h1 class="text-3xl mbs-2">Cookie Policy</h1>

  <p class="text-zinc-300 my-4">
    This platform uses "Strictly Necessary" cookies for authentication and via <Link
      href={CLOUDFLARE_COOKIE_POLICY}
      target="_blank"
      rel="noopener noreferrer">Cloudflare</Link
    > for security and performance. These do not require consent.
  </p>

  <h2 class="text-2xl">Third-Party Cookies</h2>
  <p class="text-zinc-300 my-4">
    When a profile contains external content via iframes (e.g., a YouTube video), that external provider may set tracking cookies. <strong
      >{PLATFORM_NAME}</strong
    > will provide a consent banner, to ensure these cookies are not set without user awareness and agreement.
  </p>
  <p class="text-zinc-300">Users can change their mind later and revoke their consent by clicking "Cookie Preferences" in the footer.</p>

  <h2 class="text-2xl my-4">Third-party services with no cookies</h2>
  <ul>
    <li>Azure</li>
    <li>Backblaze B2</li>
    <li>jsDelivr</li>
  </ul>

  <h2 class="text-2xl my-4">More information</h2>
  <p class="text-zinc-300">
    Full list of Cloudflare cookies: <Link href={CLOUDFLARE_COOKIE_POLICY} target="_blank" rel="noopener noreferrer"
      >{CLOUDFLARE_COOKIE_POLICY}</Link
    >
  </p>

  <p class="text-zinc-300 mbs-4">For questions: <Link href={`mailto:${emails.contact}`}>{emails.contact}</Link></p>

  <p class="text-zinc-400 mbs-6">Last updated: March 2026</p>
</ArticleLayout>
