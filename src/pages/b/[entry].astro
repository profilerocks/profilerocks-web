---
import { Markup } from "astro-remote";
import Code from "#src/components/Code.astro";
import Link from "#src/components/Link.astro";
import MdH1 from "#src/components/MdH1.astro";
import MdH2 from "#src/components/MdH2.astro";
import MdH3 from "#src/components/MdH3.astro";
import MdH4 from "#src/components/MdH4.astro";
import MdH5 from "#src/components/MdH5.astro";
import MdH6 from "#src/components/MdH6.astro";
import MdOl from "#src/components/MdOl.astro";
import MdP from "#src/components/MdP.astro";
import MdUl from "#src/components/MdUl.astro";
import Strong from "#src/components/Strong.astro";
import ArticleLayout from "#src/layouts/ArticleLayout.astro";
import { blogCollection } from "#src/lib/collections";

export async function getStaticPaths() {
  const paths = [];

  for (const post of blogCollection) {
    paths.push({
      params: { entry: post.id },
      props: { post }
    });
  }

  return paths;
}

const { post } = Astro.props;
---

<ArticleLayout title={post.data.title}>
  <hgroup>
    <h1 class="text-center text-3xl">{post.data.title}</h1>
    <p class="max-w-max mx-auto text-zinc-300 mbs-3">{post.data.description}</p>
  </hgroup>

  <p class="flex text-zinc-400 gap-4 justify-between mbs-4 mbe-6 border-be border-zinc-700 pbe-1.5">
    <time datetime={post.data.date.toISOString().split("T")[0]}>{post.data.date.toDateString()}</time>
    <span title="Author">{post.data.author}</span>
  </p>

  <Markup
    components={{
      a: Link,
      code: Code,
      h1: MdH1,
      h2: MdH2,
      h3: MdH3,
      h4: MdH4,
      h5: MdH5,
      h6: MdH6,
      ol: MdOl,
      p: MdP,
      strong: Strong,
      ul: MdUl
    }}
    content={post.rendered.html}
  />
</ArticleLayout>
