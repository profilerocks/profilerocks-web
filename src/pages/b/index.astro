---
import { Icon } from "astro-icon/components";
import LinkNext from "#src/components/LinkNext.astro";
import { blogCollection } from "#src/lib/collections";
import MainLayout from "#src/layouts/MainLayout.astro";
---

<MainLayout>
  <h1 class="text-center text-3xl">Blog</h1>
  <div class="mx-auto max-w-3xl *:border-bs *:border-emerald-400 *:pbs-4 *:mbs-5">
    {blogCollection.map(post => {
      const href = "/b/" + post.id;

      return (
        <article>
          <p class="flex gap-4 justify-between px-2.5 text-zinc-400">
            <time datetime={post.data.date.toISOString().split("T")[0]}>{post.data.date.toDateString()}</time>
            <span title="Author">{post.data.author}</span>
          </p>
          <a {href} class="block px-2.5 text-2xl text-emerald-400 hover:text-emerald-300 active:text-emerald-200 transition-colors mbs-2">
            {post.data.title}
          </a>
          <p class="px-2.5 text-zinc-300 mbs-2 mbe-4">{post.data.description}</p>
          <LinkNext {href}>
            <Icon class="drop-shadow-xs drop-shadow-black" name="page" size="1.25em" />
            Read more
          </LinkNext>
        </article>
      );
    })}
  </div>
</MainLayout>
