---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const {
  props: { class: className, ...props }
} = Astro;
---

<a
  class:list={[
    "flex items-center gap-2.5 rounded-3xl p-2.5 font-medium whitespace-nowrap transition-colors select-none hover:bg-zinc-700 active:bg-zinc-600",
    className
  ]}
  {...props}><slot /></a
>
