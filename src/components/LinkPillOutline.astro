---
import LinkPill from "#src/components/LinkPill.astro";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof LinkPill>;

const {
  props: { class: className, ...props }
} = Astro;
---

<LinkPill {...Astro.props} class:list={["text-teal-500 hover:text-teal-400 active:text-teal-300", className]}><slot /></LinkPill>
