---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button">;

const {
  props: { class: className, ...props }
} = Astro;
---

<button
  class:list={[
    "flex items-center gap-2 rounded-3xl bg-zinc-400 p-2.5 text-black transition-colors select-none enabled:cursor-pointer enabled:hover:bg-zinc-300 enabled:active:bg-zinc-200 disabled:cursor-not-allowed disabled:bg-zinc-600 disabled:text-zinc-950",
    className
  ]}
  {...props}
>
  <slot />
</button>
