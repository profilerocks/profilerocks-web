---
import LinkPill from "#src/components/LinkPill.astro";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof LinkPill>;

const {
  props: { class: className, ...props }
} = Astro;
---

<LinkPill class:list={["bg-zinc-800 text-zinc-400 hover:text-zinc-300 active:text-zinc-200", className]} {...props}><slot /></LinkPill>
