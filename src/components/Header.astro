---
import { HREF_APP } from "astro:env/client";
import { Icon } from "astro-icon/components";
import LinkActive from "#src/components/LinkActive.astro";
import LogoLong from "#src/static/logo/long.svg";

const iconDimension = "1.25em";
---

<header class="sticky inset-bs-0 z-1 mx-auto mbe-2 flex w-full max-w-475 items-center gap-2 px-4 pbs-3.5 before:absolute before:inset-x-0 before:inset-bs-0 before:-z-1 before:shadow-[0_0_1.75em_3.75em_#000]">
  <a class="w-3xs min-w-0 select-none sm:me-3" href="/">
    <LogoLong />
  </a>
  <input
    class="hamburger peer relative order-1 h-11 min-w-11 cursor-pointer appearance-none rounded-full text-zinc-400 transition-colors before:absolute before:inset-s-2.5 before:inset-bs-4 before:h-0.5 before:w-6 before:rounded-xs before:bg-current before:transition-transform after:absolute after:inset-s-2.5 after:inset-be-4 after:h-0.5 after:w-6 after:rounded-xs after:bg-current after:transition-transform checked:before:inset-bs-5.5 checked:before:rotate-45 checked:after:inset-be-5 checked:after:-rotate-45 hover:bg-zinc-700 hover:text-zinc-300 active:bg-zinc-600 active:text-zinc-200 md:hidden"
    type="checkbox"
  />
  <nav class="fixed inset-x-0 inset-bs-5 inset-be-0 -z-1 flex flex-col gap-x-5.5 bg-black/90 pbs-14 text-3xl transition-all duration-300 select-none *:flex *:items-center *:gap-3 *:py-4 *:ps-5 *:pe-7 *:text-zinc-400 *:transition peer-not-checked:invisible peer-not-checked:opacity-0 *:after:ms-auto *:after:scale-0 *:after:font-light *:after:text-zinc-400 *:after:opacity-0 *:after:transition *:after:content-['>'] *:hover:text-zinc-300 *:hover:after:scale-100 *:hover:after:opacity-100 *:active:text-zinc-200 *:active:after:scale-100 *:active:after:opacity-100 md:static md:flex-row md:bg-transparent md:pbs-0 md:text-base md:select-text md:*:gap-1.5 md:*:p-0 md:peer-not-checked:visible md:peer-not-checked:opacity-100 md:*:after:hidden">
    <LinkActive href="/b">
      <Icon name="blog" size={iconDimension} />
      Blog
    </LinkActive>
    {/*<LinkActive href="/r"><IconRoadmap size={iconDimension} />Roadmap</Link>*/}
    {/*<LinkActive href="/m"><IconMarket size={iconDimension} />Marketplace</Link>∫*/}
    <LinkActive href="/i/pricing">
      <Icon name="pricing" size={iconDimension} />
      Pricing
    </LinkActive>
  </nav>
  <a
    class="ms-auto flex gap-2.5 rounded-3xl p-2.5 font-medium text-zinc-400 transition-colors select-none hover:bg-zinc-700 hover:text-zinc-300 active:bg-zinc-600 active:text-zinc-200 sm:bg-zinc-800"
    href={HREF_APP}
    title="Log in or register"
  >
    <Icon class="drop-shadow-sm drop-shadow-black" name="user/single" size="1.5em" />
    <span class="hidden pe-1.5 sm:inline">Log in or register</span>
  </a>
</header>

<style is:global>
  body:has(.hamburger:checked) {
    overflow: hidden;
  }
</style>
