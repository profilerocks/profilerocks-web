---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const {
  props: { class: className, href, ...restProps }
} = Astro;

let active = false;

if (href) {
  let hrefPathname: string;

  if (href instanceof URL) {
    hrefPathname = href.pathname;
  } else {
    hrefPathname = "";

    let i = 0;
    let run = true;

    do {
      const char = href[i];

      switch (char) {
        case "?":
        case "#":
          run = false;
          break;
        default:
          hrefPathname += char;
          i++;
      }
    } while (run && i < href.length);
  }

  active = Astro.url.pathname.replace(/(index)?\.html/, "") === hrefPathname;
}
---

<a aria-current={active ? "page" : "false"} {href} {...restProps}><slot /></a>
