---
import type { HTMLAttributes } from "astro/types";

type Props = Exclude<HTMLAttributes<"a">, "aria-current">;

const {
  props: { class: className, ...restProps }
} = Astro;

let active = false;

if (restProps.href) {
  let hrefPathname: string;

  if (restProps.href instanceof URL) {
    hrefPathname = restProps.href.pathname;
  } else {
    hrefPathname = "";

    let i = 0;
    let run = true;

    do {
      const char = restProps.href[i];

      switch (char) {
        case "?":
        case "#":
          run = false;
          break;
        default:
          hrefPathname += char;
          i++;
      }
    } while (run && i < restProps.href.length);
  }

  active = Astro.url.pathname.replace(/(index)?\.html/, "") === hrefPathname;
}
---

<a {...restProps} aria-current={active ? "page" : "false"} class:list={[className, active && "!text-emerald-400"]}><slot /></a>
