---
import type { HTMLAttributes } from "astro/types";

type Props = Exclude<HTMLAttributes<"a">, "aria-current">;

const {
  props: { class: className, ...props }
} = Astro;

let active = false;

if (props.href) {
  let hrefPathname: string;

  if (props.href instanceof URL) {
    hrefPathname = props.href.pathname;
  } else {
    hrefPathname = "";

    let i = 0;
    let run = true;

    do {
      const char = props.href[i];

      switch (char) {
        case "?":
        case "#":
          run = false;
          break;
        default:
          hrefPathname += char;
          i++;
      }
    } while (run && i < props.href.length);
  }

  active = Astro.url.pathname.replace(/(index)?\.html/, "") === hrefPathname;
}
---

<a
  {...props}
  aria-current={active ? "page" : "false"}
  class:list={[className, active && "!text-emerald-400 hover:!text-emerald-300 active:!text-emerald-200"]}><slot /></a
>
