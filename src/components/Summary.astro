---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"summary">;

const {
  props: { class: className, ...props }
} = Astro;
---

<summary
  class:list={[
    "flex cursor-pointer items-center gap-4 py-4 text-lg text-zinc-200 select-none after:ms-auto after:min-h-7 after:min-w-7 after:rounded-full after:text-center after:leading-6.5 after:font-light after:text-zinc-400 after:transition after:content-['>'] group-open:after:rotate-90 group-open:after:text-emerald-400 hover:after:bg-zinc-700 hover:after:text-zinc-300 group-open:hover:after:text-emerald-300 active:after:bg-zinc-600 active:after:text-zinc-200 group-open:active:after:text-emerald-200 sm:text-xl",
    className
  ]}
  {...props}><slot /></summary
>
