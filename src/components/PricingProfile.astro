---
import { HREF_PROFILE_CREATE, HREF_PROFILE_CREATE_PREMIUM } from "astro:env/client";
import { Icon } from "astro-icon/components";
import { Markdown } from "astro-remote";
import free from "#shared/free.json";
import pricing from "#shared/pricing.json";
import LinkNext from "#src/components/LinkNext.astro";
import MdPPricing from "#src/components/MdPPricing.astro";
import MdStrongPricing from "#src/components/MdStrongPricing.astro";
import Ul from "#src/components/Ul.astro";
import { formatPrice, intervalToText } from "#src/lib/pricing/utils";

const components = Object.freeze({
  p: MdPPricing,
  strong: MdStrongPricing,
  ul: Ul
});
---

<div class="flex flex-col justify-center gap-8 *:flex *:basis-sm *:flex-col *:border-bs *:border-zinc-700 *:pbs-4 sm:px-2 sm:*:border-x sm:*:px-4 md:flex-row">
  <article id="free">
    <div class="mbe-5 text-center">
      <h3 class="text-3xl text-zinc-300">Free</h3>
      <h4 class="mbs-4 text-3xl">$0</h4>
      <p class="text-zinc-300">forever</p>
    </div>
    <LinkNext href={HREF_PROFILE_CREATE}>
      <Icon class="drop-shadow-xs drop-shadow-black" name="rocket" size="1.25em" />
      Continue
    </LinkNext>
    <Markdown {components} content={free.profile.description.join("\n")} />
  </article>

  <article class="!border-yellow-400" id="premium">
    <div class="mbe-5 text-center">
      <h3 class="text-3xl text-yellow-400">Premium</h3>
      <div class="mbs-4 flex items-center justify-center">
        {pricing.profile.premium.prices.map((price, i) => (
          <>
            <div class="flex-1">
              {/* @ts-expect-error: price.recurringInterval is not defined in price */}
              <h4 class="text-3xl">{formatPrice[price.priceCurrency]?.(price.priceAmount)}</h4>
              {/* @ts-expect-error: price.recurringInterval is not defined in price */}
              <p class="text-zinc-300">{intervalToText[price.recurringInterval] || "forever"}</p>
            </div>
            {i < pricing.profile.premium.prices.length - 1 && (
              <p class="text-zinc-300 before:mx-auto before:block before:h-4.5 before:w-px before:bg-zinc-600 after:mx-auto after:block after:h-4.5 after:w-px after:bg-zinc-600">
                or
              </p>
            )}
          </>
        ))}
      </div>
    </div>
    <LinkNext href={HREF_PROFILE_CREATE}>
      <Icon class="drop-shadow-xs drop-shadow-black" name="premium" size="1.25em" />
      Continue
    </LinkNext>
    <Markdown {components} content={pricing.profile.premium.description.join("\n")} />
  </article>
</div>
