---
import Ul from "#src/components/Ul.astro";
import { reportCategoriesDataEntries } from "#src/lib/report";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"ul">;
---

<Ul {...Astro.props}>
  {
    reportCategoriesDataEntries.map(([, value]) => (
      <li>
        {value.description ? (
          <>
            <strong class="font-medium text-zinc-300">{value.title}:</strong> {value.description}
          </>
        ) : (
          <strong class="font-medium text-zinc-300">{value.title}</strong>
        )}
      </li>
    ))
  }
</Ul>
