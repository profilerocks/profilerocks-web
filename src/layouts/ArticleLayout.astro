---
import DefaultLayout from "#src/layouts/DefaultLayout.astro";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof DefaultLayout>;
---

<DefaultLayout {...Astro.props}>
  <slot name="head" slot="head" />
  <main class="mx-auto max-w-6xl flex-1 px-4 pbs-2 sm:px-6 sm:pbs-4">
    <slot />
  </main>
</DefaultLayout>
