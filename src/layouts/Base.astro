---
import BaseHead from "#src/components/BaseHead.astro";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof BaseHead>;
---

<html class="h-full scrollbar-thumb-zinc-400 scroll-smooth scrollbar-gutter-both" lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <BaseHead {...Astro.props} />
    <slot name="head" />
  </head>

  <body class="flex min-h-full flex-col bg-black text-zinc-100">
    <slot />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    color-scheme: dark light;
  }
</style>
